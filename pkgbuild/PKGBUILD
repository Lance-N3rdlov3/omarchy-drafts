pkgname=drafts
pkgver=0.1.0
pkgrel=1
pkgdesc='Where text starts — quick-capture text editor, workspaces, and JavaScript action engine for Omarchy Linux'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'sqlite' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/drafts "$pkgdir/usr/bin/drafts"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/drafts.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/drafts.svg"
  install -Dm644 "$startdir/drafts.desktop" "$pkgdir/usr/share/applications/drafts.desktop"
}
